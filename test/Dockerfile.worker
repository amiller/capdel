# A swarm worker in the SPEC 3.8 shape: its ONLY environment is CAPDEL_URL + a scoped
# token (set by compose, per worker). No source, no credentials, no plan — it discovers
# what it holds from the broker (GET /whoami) and self-derives its allow/deny probes.
FROM python:3.12-alpine
COPY test/worker.py /worker.py
ENTRYPOINT ["python3", "-u", "/worker.py"]
